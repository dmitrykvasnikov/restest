# Copy to .env and adjust. .env is git-ignored because it holds the password.
#
# docker compose reads this file automatically. `make run`, which runs the
# binary on the host against the database in compose, does not: it has its own
# defaults, overridable in the environment.

# --- database, as compose creates it -----------------------------------------
POSTGRES_USER=restest
POSTGRES_PASSWORD=restest
POSTGRES_DB=restest
# Host port for the database. Published on 127.0.0.1 only.
POSTGRES_PORT=5432

# --- application --------------------------------------------------------------
# Host port for the application.
RESTEST_PORT=8080
# The address users actually reach this instance on, with no trailing slash.
# Shown in the UI as the root of every mock URL. Its scheme also decides whether
# session and CSRF cookies are marked Secure, so behind TLS this must be the
# https address — otherwise the cookies never come back and nobody can log in.
RESTEST_BASE_URL=http://localhost:8080
# Interface the application is published on. 0.0.0.0 exposes it to the network;
# do that only when you mean to.
RESTEST_BIND=127.0.0.1
# debug | info | warn | error
RESTEST_LOG_LEVEL=info
# json for deployments, text for a readable terminal
RESTEST_LOG_FORMAT=json

# --- the request log ----------------------------------------------------------
# Bytes of each recorded request and response body kept, 0 to 1048576. Above it
# the body is stored truncated and shown as truncated.
RESTEST_LOG_BODY_LIMIT=65536
# Exchanges that may wait to be written. Beyond it they are dropped and counted
# rather than made to wait: a request is never slowed down by the log of it.
RESTEST_LOG_BUFFER=1000
# Months of request log kept, counting the current one. Expiry detaches and
# drops that month's partition, so it costs a file unlink rather than a DELETE.
RESTEST_LOG_RETENTION_MONTHS=3

# --- the demo project ---------------------------------------------------------
# The shared demo at /m/demo/, holding every built-in dataset and served to
# anyone with no account. false leaves it unprovisioned and stops the login page
# offering it; a demo already in the database is left alone rather than deleted.
RESTEST_DEMO_ENABLED=true
# How often the demo is restored to its seeds, so one visitor's writes cannot
# spoil it for the next. Also runs once at startup. Between 1m and 168h.
RESTEST_DEMO_RESET_INTERVAL=1h

# --- rate limiting ------------------------------------------------------------
# Requests per second per key. Zero turns a limit off. The bucket depth is twice
# the rate, with a floor of 20, so a client that has been idle can spend two
# seconds' worth at once.
#
# Mock traffic, per client address, across every project.
RESTEST_RATE_LIMIT_IP=50
# Mock traffic, per project, across every client. A project a whole CI fleet
# points at is one the per-address limit would never notice.
RESTEST_RATE_LIMIT_PROJECT=200
# The management API, per credential — the token, or the account behind the
# session. The interface itself is not limited.
RESTEST_RATE_LIMIT_API=20
# Whose X-Forwarded-For to believe: a comma-separated list of addresses and CIDR
# blocks. Empty — the default — means the header is never read and every request
# is attributed to the address it arrived from. Set it to the proxy in front of
# this instance, or the per-address limit counts the whole internet as one
# client and the request log records the proxy for every request.
# RESTEST_TRUSTED_PROXIES=172.18.0.0/16

# --- limits and timeouts ------------------------------------------------------
# Bytes. Applied to every request body before any handler reads one.
RESTEST_MAX_REQUEST_BODY=1048576
# Bytes of request line and headers.
RESTEST_MAX_HEADER_BYTES=65536
# How long a client may take to send its headers, its whole request, and to
# receive its response; and how long an idle kept-alive connection may sit.
RESTEST_READ_HEADER_TIMEOUT=10s
RESTEST_READ_TIMEOUT=30s
RESTEST_WRITE_TIMEOUT=30s
RESTEST_IDLE_TIMEOUT=120s

# --- metrics ------------------------------------------------------------------
# The Prometheus exposition at /metrics. Off, the path answers 404.
RESTEST_METRICS_ENABLED=true
# When set, /metrics requires this as `Authorization: Bearer …`. Leave it empty
# on an instance whose proxy does not route /metrics; set it on one that
# publishes the path as it stands, because the scrape names every project's
# traffic volume and this process's memory layout.
# RESTEST_METRICS_TOKEN=
